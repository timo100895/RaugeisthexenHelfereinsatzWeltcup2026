# ============================================================
# Umgebungsvariablen – Helfereinteilung Ornemer Raugeisthexen
# ============================================================
# Diese Datei enthaelt KEINE echten Zugangsdaten.
# Kopiere sie zu ".env" fuer die lokale Entwicklung und trage
# dort deine echten Werte ein ("cp .env.example .env").
#
# Bei Cloudflare Pages muessen dieselben Variablen unter
# "Settings -> Environment variables" fuer "Production" und
# "Preview" hinterlegt werden (siehe README.md, Abschnitt
# "Cloudflare Einrichtung").
# ============================================================

# Supabase Projekt-URL (Project Settings -> API -> Project URL)
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Supabase "anon" public key (Project Settings -> API -> anon public)
# Dieser Key ist bewusst oeffentlich und wird im Frontend verwendet.
# Der Datenzugriff wird ausschliesslich ueber Row Level Security (RLS)
# und die RPC-Funktionen in supabase/migrations abgesichert.
VITE_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Name der Anwendung (fuer Titel/Meta-Tags)
VITE_APP_NAME="Ornemer Raugeisthexen – Helfereinteilung"

# ------------------------------------------------------------
# Die folgenden Variablen werden NUR serverseitig in den
# Supabase Edge Functions verwendet (supabase/functions/*).
# Sie werden NIEMALS im Frontend-Bundle verwendet und muessen
# ausschliesslich als Supabase Secrets hinterlegt werden:
#
#   supabase secrets set RESEND_API_KEY=xxxxx
#
# NIEMALS in Cloudflare oder im Frontend-Build hinterlegen!
# ------------------------------------------------------------

# API-Key des Mailversands (z.B. https://resend.com)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Absenderadresse fuer System-E-Mails (muss bei Resend verifiziert sein)
MAIL_FROM="Ornemer Raugeisthexen <helferliste@ornemer-raugeisthexen.de>"

# Kommagetrennte Liste von Adressen, die bei neuen Anmeldungen
# benachrichtigt werden sollen (Vorstand)
NOTIFY_EMAILS="vorstand@ornemer-raugeisthexen.de"

# Basis-URL der oeffentlichen Anwendung (fuer Links in E-Mails)
PUBLIC_SITE_URL="https://weltcup2026.ornemer-raugeisthexen.de"

# Supabase Service Role Key – NUR fuer die Edge Function noetig,
# wird von Supabase automatisch als SUPABASE_SERVICE_ROLE_KEY
# in jede Edge Function injiziert. Hier nur zur Dokumentation.
# NIEMALS manuell setzen oder ins Frontend uebernehmen!
# SUPABASE_SERVICE_ROLE_KEY=(wird automatisch bereitgestellt)
